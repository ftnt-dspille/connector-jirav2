# Used only by the online tests (tests/test_live.py, tests/test_live_scopes.py).
# Copy to tests/.env (git-ignored). Never put these on a command line.
JIRA_LIVE_SERVER=https://yourcompany.atlassian.net
JIRA_LIVE_USER=you@example.com
# an UNRESTRICTED API token for that account
JIRA_LIVE_TOKEN=
# optional: a project key you accept test issues in. Empty = find any project that works.
JIRA_LIVE_PROJECT=
